# Токен бота от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Telegram ID пользователей, которым разрешено пользоваться ботом (через запятую).
# Узнать свой ID: напишите боту /id (он ответит даже «чужим») или @userinfobot.
ALLOWED_USERS=123456789

# Для локального Bot API сервера (лимит файлов 2 ГБ): https://my.telegram.org → API development tools
API_ID=12345
API_HASH=0123456789abcdef0123456789abcdef

# Необязательное
# MAX_PARALLEL=1          # сколько ffmpeg одновременно (по числу ядер / 2)
# MAX_VARIANTS=5          # максимум вариантов на файл
# MAX_FILE_MB=2000        # лимит входного файла
# PROGRESS_INTERVAL=3     # как часто обновлять статус, сек
# FILE_CACHE_TTL_MIN=60   # чистить кеш файлов Bot API сервера старше N минут (0 — не чистить)
# LOG_LEVEL=INFO
